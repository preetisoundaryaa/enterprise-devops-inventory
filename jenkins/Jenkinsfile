pipeline {
    agent any

    environment {
        APP_NAME = 'enterprise-devops-inventory'
        IMAGE_TAG = "${env.BUILD_NUMBER}"
        REGISTRY = 'your-registry.example.com'
        IMAGE = "${REGISTRY}/${APP_NAME}:${IMAGE_TAG}"
        DAST_TARGET_URL = 'http://enterprise-devops-inventory.default.svc.cluster.local:8000'
    }

    stages {
        stage('checkout') {
            steps {
                checkout scm
            }
        }

        stage('build') {
            steps {
                sh 'python3 -m pip install --upgrade pip'
                sh 'pip3 install -r app/inventory-api/requirements.txt'
                sh 'python3 -m py_compile app/inventory-api/main.py app/inventory-api/models.py app/inventory-api/database.py'
            }
        }

        stage('SAST - Static code analysis') {
            steps {
                sh '''
                    python3 -m pip install --upgrade bandit
                    mkdir -p reports
                    bandit -r app/inventory-api -f json -o reports/sast-bandit.json
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: 'reports/sast-bandit.json', onlyIfSuccessful: false
                }
            }
        }

        stage('SCA - Dependency vulnerability scanning') {
            steps {
                sh '''
                    python3 -m pip install --upgrade pip-audit
                    mkdir -p reports
                    pip-audit -r app/inventory-api/requirements.txt -f json -o reports/sca-pip-audit.json
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: 'reports/sca-pip-audit.json', onlyIfSuccessful: false
                }
            }
        }

        stage('docker build') {
            steps {
                sh 'docker build -t ${IMAGE} app/inventory-api'
            }
        }

        stage('Container scanning') {
            steps {
                sh '''
                    mkdir -p reports
                    docker run --rm \
                        -v /var/run/docker.sock:/var/run/docker.sock \
                        -v "$PWD:/workspace" \
                        aquasec/trivy:latest image --format json \
                        --output /workspace/reports/container-trivy.json \
                        ${IMAGE}
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: 'reports/container-trivy.json', onlyIfSuccessful: false
                }
            }
        }

        stage('docker push') {
            steps {
                sh 'docker push ${IMAGE}'
            }
        }

        stage('deploy to Kubernetes') {
            steps {
                sh "sed -i 's#your-registry/enterprise-devops-inventory:latest#${IMAGE}#' kubernetes/deployment.yaml"
                sh 'kubectl apply -f kubernetes/postgres.yaml'
                sh 'kubectl apply -f kubernetes/deployment.yaml'
                sh 'kubectl apply -f kubernetes/service.yaml'
                sh 'kubectl apply -f kubernetes/hpa.yaml'
            }
        }

        stage('OWASP ZAP DAST scanning') {
            steps {
                sh '''
                    mkdir -p reports
                    docker run --rm \
                        -v "$PWD/reports:/zap/wrk" \
                        ghcr.io/zaproxy/zaproxy:stable zap-baseline.py \
                        -t ${DAST_TARGET_URL} \
                        -J zap-baseline.json \
                        -r zap-baseline.html
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: 'reports/zap-baseline.json, reports/zap-baseline.html', onlyIfSuccessful: false
                }
            }
        }

        stage('Log Analytics integration') {
            steps {
                sh '''
                    if [ -n "$LOG_ANALYTICS_ENDPOINT" ] && [ -n "$LOG_ANALYTICS_TOKEN" ]; then
                        jq -n \
                          --arg app "$APP_NAME" \
                          --arg build "$BUILD_NUMBER" \
                          --arg image "$IMAGE" \
                          --arg status "security-scans-completed" \
                          --arg timestamp "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
                          '{app: $app, build: $build, image: $image, status: $status, timestamp: $timestamp}' > reports/log-analytics-payload.json

                        curl -sS -X POST "$LOG_ANALYTICS_ENDPOINT" \
                            -H "Authorization: Bearer $LOG_ANALYTICS_TOKEN" \
                            -H 'Content-Type: application/json' \
                            --data-binary @reports/log-analytics-payload.json
                    else
                        echo "LOG_ANALYTICS_ENDPOINT or LOG_ANALYTICS_TOKEN not configured; skipping log shipping"
                    fi
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: 'reports/log-analytics-payload.json', onlyIfSuccessful: false, allowEmptyArchive: true
                }
            }
        }
    }
}
